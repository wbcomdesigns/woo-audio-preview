{
	"$schema": "https://wpmediaverse.com/schemas/wp-plugin-qa-config-v1.json",
	"slug": "woo-audio-preview",
	"name": "Audio Preview for WooCommerce",
	"version_constant": "WCAP_VERSION",
	"main_file": "woo-audio-preview.php",
	"pair": {
		"pro_slug": "woo-audio-preview-pro",
		"pro_repo": "wbcomdesigns/woo-audio-preview-pro",
		"lockstep": false
	},
	"base_url": "http://woo.local",
	"autologin_param": "autologin",
	"rest_namespace": null,
	"requires": {
		"plugins": [
			"woocommerce"
		]
	},
	"front_routes": [
		"/shop/",
		"/product/{slug}/"
	],
	"admin_routes": [
		"/wp-admin/admin.php?page=wbcomplugins",
		"/wp-admin/admin.php?page=woo-audio-preview",
		"/wp-admin/post.php?action=edit (product, Audio Preview metabox)"
	],
	"ajax_actions": [
		{
			"action": "wcap_delete_audio_ajax",
			"auth": "manage_options (product edit)",
			"nonce": "yes"
		}
	],
	"shortcodes": [],
	"player_hook": "woocommerce_before_add_to_cart_form (filter wcap_preview_hook)",
	"themes": [
		"storefront",
		"buddyx",
		"reign-theme",
		"twentytwentyfive"
	],
	"viewports": [
		1440,
		1024,
		390
	],
	"color_schemes": [
		"light",
		"dark"
	],
	"basecamp": {
		"project_id": 42374833,
		"triage_column_id": 8667199162,
		"bugs_column_id": 8667199173,
		"ready_for_development_column_id": 8667199187,
		"ready_for_testing_column_id": 8667199197
	},
	"modes": [
		"free",
		"combo"
	],
	"report_path": "docs/qa/.last-smoke-pass.json",
	"journeys_path": "audit/journeys",
	"role_matrix": "audit/ROLE_MATRIX.md",
	"personas": [
		{
			"id": "anon",
			"label": "Shopper viewing a product",
			"login": null,
			"role": null,
			"ladder": 2
		},
		{
			"id": "customer",
			"label": "Logged-in customer",
			"login": "shopper",
			"role": "customer",
			"ladder": 3
		},
		{
			"id": "admin",
			"label": "Store owner / administrator (control rung)",
			"login": "varundubey",
			"role": "administrator",
			"ladder": 6,
			"autologin": "1"
		}
	],
	"checks": {
		"states": [
			{
				"id": "hub-icons-render",
				"persona": "admin",
				"url": "/wp-admin/admin.php?page=wbcomplugins",
				"setup": "only Audio Preview active",
				"expect": [
					{
						"note": "the WB Plugins hub icons render (assets/vendor/lucide.min.js ships in the zip)"
					}
				]
			},
			{
				"id": "supported-url-saves",
				"persona": "admin",
				"setup": "product edit, Audio Preview metabox",
				"expect": [
					{
						"note": "every URL type the public renderer supports is accepted on save (admin and public service lists agree)"
					}
				]
			}
		],
		"crawl": [
			{
				"url": "/shop/",
				"persona": "anon"
			},
			{
				"url": "/product/beanie/",
				"persona": "anon"
			}
		]
	}
}
